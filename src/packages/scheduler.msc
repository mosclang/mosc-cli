kulu Diabi {
  nin _data
  nin _fili
  @weele
  dilan kura(ale._data, ale._fili) {
  }
  @weele 
  dilan kura(ale._data) {}

  kolon => ale._fili
  gnuman => ale._data
  gnumanWalima => nii ale._fili == gansan ale._data note Djuru.tike(ale._fili)
  gnana => ale._fili == gansan
  resolve(res, rej) {
    nii ale._fili == gansan res(ale._data) note rej(ale._fili)
  }
  dialen fuu => Diabi(gansan, gansan)
  dialen fili(msg) => Diabi(gansan, msg)
  sebenma => "{fili: ${ale._fili}, data: ${ale._data}}"
}
kulu DogodaBaga {
  dialen nin __scheduled;
  dialen aFaraAkan(callable) {
    nii (__scheduled == gansan) __scheduled = []
   __scheduled.aFaraAkan(Djuru.kura {
      callable.weele()
      DogodaBaga.runNextScheduled_()
    })
  }

  # Called by native code.
  dialen resume_(djuru) { djuru.alaTeme() }
  dialen run_(cb) { DogodaBaga.nextTick {
    cb.weele(Diabi.fuu)
  }}
  dialen resume_(djuru, arg) { djuru.alaTeme(arg) }
  dialen run_(cb, arg) { DogodaBaga.nextTick {
    cb.weele(Diabi(arg))
  }}
  dialen runError_(cb, error) {
    DogodaBaga.nextTick {
      cb.weele(Diabi.fili(error))
    }
  }
  dialen resumeError_(djuru, error) {
    segin niin djuru.filiLaTeme(error)
  }

  # wait for a method to finish that has a callback on the C side
  dialen await_(fn) {
    fn.weele()
    segin niin DogodaBaga.runNextScheduled_()
  }

  dialen runNextScheduled_() {
    nii (__scheduled == gansan || __scheduled.laKolon) {
      segin niin Djuru.djo()
    } note {
      segin niin __scheduled.aBoOyorola(0).alaTeme()
    }
  }
  dialen runNextTick_() {
    segin niin Djuru.djo()
  }

  dialen trigger() {
    nin current = Djuru.sissanTa
    DogodaBaga.aFaraAkan {
        current.alaTeme()
    }
    DogodaBaga.runNextScheduled_();
  }
  dialen run(cb) {
    Djuru.kura(cb).alaTeme()
  }
  dunan dialen captureMethods_()
  dunan dialen nextTick(cb)
  
}

DogodaBaga.captureMethods_()
