kabo "mio/mio" nani MioServerContext, MioRouter
kabo "json" nani JSON
kulu IndexControler ye MioRouter {
    nin list = []
    @weele
    dilan kura() {}

    @!get(path="/health")
    health(req, res) {
        res.end("Hello Guy")
    }
    @!post(path="/new")
    post(req, res) {
        nin b = req.body.kononWaliGansan
        A.yira(b)
        nin body = JSON.parse(b)
        ale.list.aFaraAkan(body)
        res.cork { r => r.end(ale.list) }
    }
    @!any(path="/")
    index(req, res) {
        res.end(ale.list)
    }
}


MioServerContext().registerRouter(IndexControler()).run(3001)