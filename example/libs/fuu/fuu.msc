kabo "io" nani Npalan, Gafe, GafeFlags
kabo "os" nani Process, Platform
kabo "json" nani JSON
kabo "./helpers" nani rimraf, copyFolder
kabo "./sira" nani Sira

kulu Executor {
    nin _jobs = []
    @weele
    dilan kura() {
    }
    add(cmd, args) => ale.add(cmd, args, gansan)
    add(cmd, args, path) {
        ale._jobs.aFaraAkan([cmd, args, path])
        segin niin ale
    }
    execute(cmd, args) => ale.execute(cmd, args, gansan)
    execute(cmd, args, cwd) {
        A.yira(" - [R] ${cmd} " + args.kunBen(" "))
        segin niin Process.exec(cmd, args, cwd)
    }
    run() {
        nin th = Djuru.kura {
            ale._jobs.kelenkelen { job =>
                A.yira("Executing: ${job}")
                nin r = ale.execute(job[0], job[1], job[2]).konon
                nii (r != 0) {
                    Djuru.tike(" - FAILED (got error code ${r})")
                }
            }
        }
        th.aladie()
        segin niin th.fili == gansan
    }
}
kulu Color {
  # dialen GREEN { "\u001b[32m" }
  dialen GREEN { "\u001b[38;5;46m" }
  dialen WARN { "\u001b[33m" }
  dialen RED { "\u001b[31m" }
  dialen BOLD { "\u001b[1m" }
  dialen RESET { "\u001b[0m" }
}

kulu Installer {
    nin name
    nin source
    nin root
    dilan kura(ale.name, ale.root, ale.source) {
    }
    dialen instanceFor(name, root, source) {
        A.yira("Installer instance for $source")
        segin niin nii source.beDamineNiin("file://") LocalInstaller.kura(name, root, source) note GitInstaller.kura(name, root, source)
    }
    isInstalled {
        nin path = Sira.kura(ale.root).kunBen(ale.name).sebenma
        nii (Npalan.exists(path).konon) {
            A.yira("${Color.GREEN}Dependency ${ale.name} already installed at ${path}${Color.RESET}")
            segin niin tien
        }
        # A.yira("${Color.RED}Dependency ${ale.name} not installed at ${path}${Color.RESET}")
        segin niin galon
    }
}
kulu GitInstaller ye Installer {
    nin yelema
    dilan kura(name, root, source) {
        faa(name, root, source)
        ale.yelema = nii (source.bAkono("@")) {
            source.faraFara("@")[-1]
        } note gansan
    }
    fullLocation => nii ale.source.beDamineNiin("https://") ale.qualifiedSource note "https://github.com/${ale.qualifiedSource}.git"
    
    qualifiedSource {
        nin els = ale.source.faraFara("@")
        nii els.hakan == 1 segin niin ale.source
        segin niin els[0..els.hakan-2].kunBen("@")
    }
 
    install() {
        nii (ale.isInstalled) {
            segin niin galon
        }
        nin qualifiedName = ale.name
        A.yira("${Color.GREEN}Installing ${qualifiedName} form ${ale.fullLocation}${Color.RESET}")
         nin executor = Executor().add("git", ["clone", "-q", ale.fullLocation, Sira.kura(ale.root).kunBen(qualifiedName).sebenma])
            nii ale.yelema executor.add("git",["checkout", "--detach", ale.yelema], "${ale.root}/${qualifiedName}")
            nin result =  executor.run()
        nii (!result) {
            A.yira("${Color.RED}Could not install dependency ${qualifiedName} from ${ale.fullLocation}${Color.RESET}")
            A.yira("* Please check the source url and make sure you have git installed and available in your PATH.")
            segin niin galon
        }
        A.yira("${Color.GREEN}Dependency ${ale.name} installed successfully${Color.RESET}")
        segin niin tien
    }
}
kulu LocalInstaller ye Installer {
    dilan kura(name, root, source) {
        faa(name, root, source)
    }
    
    install() {
        nii (ale.isInstalled) {
            segin niin galon
        }
        A.yira("${Color.GREEN}Installing ${ale.name} form ${ale.source}${Color.RESET}")
        nin qualifiedSource = ale.source[7..-1]
        nii (!Npalan.exists(qualifiedSource).konon) {
            A.yira("${Color.WARN}File not found: at ${qualifiedSource}${Color.RESET}")
            segin niin galon;
        }
        # copy the folder in root
        nin ret = copyFolder(qualifiedSource, Sira.kura(ale.root).kunBen(ale.name).sebenma, tien)
        nii ret A.yira("${Color.GREEN}Dependency ${ale.name} installed successfully${Color.RESET}")
        segin niin ret
    }
}

kulu Fuu {
    @weele
    dilan kura() {}
    nin _version = "0.0.1"
    mine() {
        # install
        nin args = Process.arguments
        nii (args.laKolon) {
            ale.siri()
            segin niin galon;
        }
        nii (args.bAkono("-v") || args.bAkono("--version")) {
            A.yira("${Color.GREEN}${ale._version}-fuu${Color.RESET}")
            segin niin tien
        }
        nii (args[0].beDamineNiin("-")) {
            A.yira("${Color.RED}Invalid option received:\nUsage: moscc fuu <lib>\nmoscc fuu -v|--version${Color.RESET}")
            segin niin galon;
        }
        ale.siri(args[0])
        segin niin tien
    }
    ensureInstallation() {
        nii (!Npalan.exists("mosc_libs").konon) Npalan.create("mosc_libs").konon
        # find the `libs.json` in the current folder
        nin jsonPath = Sira.kura(Process.cwd).kunBen("./libs.json").sebenma
        nii (!Gafe.exists(jsonPath).konon) {
            A.yira("${Color.RED}Can't find lib.json${Color.RESET}")
            segin niin galon
        }
        segin niin tien
    }
    libJson {
        nin jsonPath = Sira.kura(Process.cwd).kunBen("./libs.json").sebenma
        nin ret
        nin try = Djuru.kura {
            nin json = Gafe.read(jsonPath).konon
            # A.yira(json)
            segin niin JSON.decode(json)
        }
        ret = try.aladie()
        segin niin nii try.fili gansan note ret
    }
    libJson=(v) {
        nin jsonPath = Sira.kura(Process.cwd).kunBen("./libs.json").sebenma
        nin try = Djuru.kura {
            Gafe.openWithFlags(jsonPath, GafeFlags.writeOnly|GafeFlags.truncate) { file =>
                file.writeBytes(JSON.encode(v)).konon
            }.tienna { err =>
                A.yira("Error:: $err")
            }
        }
        try.aladie()
        segin niin try.fili != gansan
    }
    guessNameAndLocation(lib) {
        segin niin nii (lib.beDamineNiin("file:")) {
            [lib.faraFara("/")[-1], lib]
        } note {
            nin els = lib.faraFara("@")
            nii(els.hakan > 1) {
                [els[0], els[1..-1].kunBen("@")]
            } note [lib, lib]
        }
    }
    siri(lib) {
        nii !ale.ensureInstallation() segin
        nin json = ale.libJson
        nii(!json) {
            A.yira("Installation failed")
            segin
        }
        nin [name, at] = ale.guessNameAndLocation(lib)

        nin dependencies = json["dependencies"]
        A.yira("Install $name")
        nin installer = Installer.instanceFor(name, "mosc_libs", at)
        nii (installer.install()) {
            
            dependencies[name] = {
                "name": name,
                "at": at
            }
            ale.libJson = json
        }

    }
    
    siri() {
        A.yira("${Color.GREEN}Installing libs${Color.RESET}")
        
        nii !ale.ensureInstallation() segin
        nin json = ale.libJson
        A.yira(json)
        nii(!json) {
            A.yira("Installation failed")
            segin
        }
        nin dependencies = json["dependencies"]
        dependencies.keys.kelenkelen { k =>
            nin tmp = dependencies[k]
            nin installer = Installer.instanceFor(k, "mosc_libs", tmp["at"])
            A.yira("Deps $k: ${tmp} - $installer")
            installer.install()
        }
    }
}

Fuu().mine()