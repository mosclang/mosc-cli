kabo "io" nani Npalan, Gafe, Stat
kabo "./sira" nani Sira
kabo "lahidu" nani Lahidu

tii rm_(folder) {
    segin niin Lahidu.kura {res, rej =>
        nin djuru = Djuru.kura {
            nin stat = Stat.path(folder).konon
            nii (stat.yeNpalan){
                nii (Npalan.list(folder).konon.laKolon){
                 Npalan.delete(folder).konon
                 segin niin res.weele(tien)
                } note {
                  segin niin res.weele(rimraf(folder))
                }
            }
            nii (stat.yeGafe) {
                Gafe.delete(folder).konon
                segin niin res.weele(tien)
            }
            segin niin res.weele(galon)
        }
        djuru.aladie()
        nii (djuru.fili) {
          A.yira("Error: ${djuru.fili}")
         rej(djuru.fili)
        }
    }

}
tii rimraf(folder) {
    nii !Npalan.exists(folder).konon segin niin galon
    nin ret = tien
    nin promises = []
    nin children = Npalan.list(folder).konon
    children.kelenkelen { it =>
        ret = ret && promises.aFaraAkan(rm_(Sira.kura(folder).kunBen(it).sebenma))
    }
    Lahidu.konon(promises)
    Lahidu.konon(rm_(folder))
    segin niin ret
}

tii copyFolder(folder, destination, recursive) {
    A.yira("Copying file $folder to $destination")
    nii !Npalan.exists(folder).konon segin niin galon
    nin sPath = Sira.kura(folder)
    nin destPath = Sira.kura(destination)
    nii (Npalan.exists(destPath.sebenma).konon) {
        nii !rimraf(destPath.sebenma) segin niin galon
    }
    Npalan.create(destPath.sebenma).konon
    nin content = Npalan.list(folder).konon
    nin ret = tien
    seginka (content kono dir) {
        nin dirPath = sPath.kunBen(dir).sebenma
        nii (Gafe.exists(dirPath).konon) {
            nin targetPath = Sira.kura(destination).kunBen(dir).sebenma
            ## case file, copy directly
            A.yira("Copying file $targetPath")
            Gafe.open(dirPath) { source =>
                Gafe.create(targetPath) { dest => 
                    dest.writeBytes(source.readBytes(source.size.konon).konon).konon
                }.konon
                A.yira("File copied successfully to")
            }.konon
        } note {
            nii recursive ret = (ret && copyFolder(dirPath, destPath.kunBen(dir).sebenma, recursive))
        }
    }
    segin niin ret
}