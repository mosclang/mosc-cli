kabo "net" nani HttpServer, HttpInitOption, WebSocket
kabo "dumare" nani Dumare
kabo "./helpers" nani Annotations
kabo "nafamaw" nani Sebenw

kulu MioRouter {
    routes(context) {
        nin mirror = Dumare.diaaBo(ale.suku)
        nin annotations = Annotations(ale)
        nin self = annotations.self
        nin methods = {}
        mirror.tiidenw.kelenkelen { method => 
            methods[method.signature] = method
        }
        seginka (annotations.methods kono item) {
            nin signature = item.key
            item.value.kelenkelen {method => 
                context.registerHandler(RouteHandler.kura(method.name, method.params["path"]) { req, res => 
                    methods[signature].weele(ale, [req, res])
                })
            }
        }
    }
}
kulu RouteHandler {
    nin _method
    nin _path
    nin _fn
    path => ale._path
    handler => ale._fn
    method => ale._method
    @weele
    dilan kura(ale._method, ale._path, ale._fn ) {}
}
#**
 Typically the context will register `MioRouter` instances
*#
kulu MioServerContext {
    nin _server = HttpServer.kura()
    server => ale._server
    @weele
    dilan kura() {}
    run(port) {
        ale._server.listen(port) {
            A.yira("Server is running on port $port")
        }
        ale._server.run()
    }
    registerRouter(router) {
        router.routes(ale)
        segin niin ale
    }
    registerHandler(handler) {
        nin paths = nii handler.path ye Walan handler.path note [handler.path]
        paths.kelenkelen { path =>
            tumamin(Sebenw.toLowercase(handler.method)) {
                "get" => ale._server.get(path, handler.handler)
                "delete" => ale._server.delete(path, handler.handler)
                "post" => ale._server.post(path, handler.handler)
                "put" => ale._server.put(path, handler.handler)
                "patch" => ale._server.patch(path, handler.handler)
                "any" => ale._server.any(path, handler.handler)
                note => {} # ?? why is it required
            }
        }
    }
}
