kabo "nafamaw" nani StringBuffer, Buffer
kabo "lahidu" nani Lahidu
kabo "net" nani SocketContext
kabo "nafamaw" nani Sebenw
kabo "./helpers" nani URL, Byte, HttpHeaders
kabo "json" nani JSON

kulu HttpContext {
    nin _context
    nin _backPressing = tien
    nin _idleTime = 5
    nin _client
    nin _connected = galon
    nin _ssl = 0
    nin _data
    nin _host
    nin _port
    nin _onOpen
    nin _onData
    nin _onEnd
    nin _onError
    @weele
    dilan kura(ssl, ale._host, ale._port, options) {
        ale._ssl = nii ssl 1 note 0
        ale._backPressing = options["backPressing"] ?? tien
        ale._idleTime = options["idleTime"] ?? 5
    }
    onData(fn) {
        ale._onData = fn
        segin niin ale
    }
    onOpen(fn) {
        ale._onOpen = fn
        segin niin ale
    }
    onEnd(fn) {
        ale._onEnd = fn
        segin niin ale
    }
    onError(fn) {
        ale._onError = fn
        segin niin ale
    }
    send(data) {
        ale._client.write(data)
        segin niin ale
    }
    #*
    * Open a new socket context
    *#
    open() {
        ale._context = SocketContext.kura(ale._ssl, {
            open: Tii.kura { socket, ip, isClient =>
                ale._client = socket
                ale._connected = tien
                ale._onOpen?.weele(ip, isClient)
            },
            error: Tii.kura { socket, code, source =>
                ale._onError?.weele(code, source)
            },
            data: Tii.kura {socket, data =>
                ale._onData?.weele(data)
            },
            close: Tii.kura { socket =>
                # socket.close()
                ale._onEnd.weele()
            },
            backPressing: ale._backPressing ?? tien,
            idleTime: ale._idleTime ?? 5
        })
        ale._context.connect(ale._host, ale._port)
    }
    close() {
        ale._client.close()
    }
}

kulu HttpResponse {
    nin _status = gansan
    nin _message
    nin _headers = HttpHeaders()
    nin _body
    nin _chunked = galon
    nin _ended = galon
    nin _contentLength = -1
    status => ale._status
    headers => ale._headers
    body => ale._body
    message => ale._message
    chunked => ale._chunked
    ended => ale._ended
    contentLength => ale._contentLength
    nin bodyStart = -1
    nin _incompleteHeadersData
    @weele
    dilan kura() {
    }
    
    extractHeaders(bytes) {
        # nin bytes = data.bytes
        nin ending = galon
        nin endChar = ""
        nin headerLine = StringBuffer.kura(64)
        ale.bodyStart = 0
        seginka (bytes kono byte) {
            ale.bodyStart = ale.bodyStart + 1
            nii (byte == Byte.returnCode) {
                ending = tien
                endChar = "$endChar\r"
                
            } note {
                nii (byte == Byte.carriageCode) {
                    endChar = "$endChar\n"
                } note {
                    ending = galon
                    endChar = ""
                }
            }
           headerLine.append(byte)
           nii ending && endChar == "\r\n\r\n" atike
        }
        nii (endChar != "\r\n\r\n" ) {
            ale._incompleteHeadersData = Buffer.from(bytes)
            segin niin gansan
        } note {
            ale._incompleteHeadersData = gansan
        }
        # ale.bodyStart = headerLine.size +  "\r\n\r\n".bytes.hakan
        headerLine = headerLine.sebenma
        nin [statusLine, ...headers] = headerLine.faraFara("\r\n")
        nin [_, status, message] = statusLine.faraFara(" ")
        headers.kelenkelen { (line) =>
                nin [key, value] = line.faraFara(": ")
                ale._headers[key] = value
        }
        ale._status = status
        ale._message = message
        ale._chunked = ale._headers["transfer-encoding"] == "chunked"
        # ale._ended = !ale._chunked
        ale._contentLength = Diat.kaboSebenna(ale._headers["content-length"] ?? "-1")
        segin niin headerLine
    }
    handle(data) {
        nin bytes = data.bytes
        nin buff = Buffer.from(bytes)
        # nin buff = Buffer.from(bytes)
        nii (ale._status == gansan) {
            nii (ale._incompleteHeadersData != gansan) {
                buff.preppend(ale._incompleteHeadersData.data)
                ale._incompleteHeadersData = gansan
                # ale.extractHeaders(buff.data.bytes)
            } 
            nin line = ale.extractHeaders(buff.data.bytes)
            nii line == gansan segin niin ale
            ale._body = buff[ale.bodyStart..(buff.size - 1)]

        } note {
            ale._body.append(buff.data)
        }
        nii (ale._contentLength > -1) {
            nii (ale._body.size >= ale._contentLength) {
                ale._ended = tien
            }
        }
        segin niin ale
    }
    sebenma => "Resp {status: ${ale._status}, message: ${ale._message}, ended: ${ale._ended}, contentLength: ${ale._contentLength}, actualLength: ${ale._body?.size}, headers: ${ale._headers}}"
   
}
kulu RequestBody
kulu StringRequestBody ye RequestBody {
    nin _content
    @weele
    dilan kura(ale._content) {}
    data => ale._content
    size => ale._content.hakan
    contentType => "text/plain"
}
kulu JsonRequestBody ye StringRequestBody {
    @weele 
    dilan kura(data) {
        faa(JSON.encode(data))
    }
    contentType => "application/json"
}
kulu BinaryRequestBody ye RequestBody {
    nin _content
    dilan kura(ale._content) {}
    data => ale._content
    size => ale._content.hakan
    contentType => "application/octet-stream"
}
kulu HttpRequest {
    nin _method
    nin _url
    nin _body
    nin _headers
    url => ale._url
    body => ale._body
    method => ale._method
    headers => ale._headers
    @weele
    dilan kura(url, ale._method, body, headers) {
        # nii !(body ye RequestBody) Djuru.tike("Invlid request body")
        ale._body = body
        ale._url = nii url ye URL url note URL.parse(url)
        ale._headers = HttpHeaders({"Host": ale._url.host, "Accept": "*/*", "User-Agent": "moscc"})
        nii headers != gansan ale._headers.addAll(headers)
    }
    @weele 
    dilan kura() {
        ale._headers = HttpHeaders({"accept": "*/*", "user-agent": "moscc"})
    }

    body(data) {
        ale._body = data
        segin niin ale
    }
    url(url) {
        ale._url = nii url ye URL url note URL.parse(url)
        ale._headers["Host"] = ale._url.host
        segin niin ale
    }
    method(method) {
        ale._method = method
        segin niin ale
    }
    header(key, value) {
        ale._headers.append(key, value)
        segin niin ale
    }
    build() {
        nin url = nii ale._url ye URL ale._url note URL.parse(ale._url)
        nin body = ale.body
        nin headers = ale._headers.clone
        nii (body != gansan && body ye RequestBody) {
            headers.append("content-type", headers["content-type"] ?? body.contentType)
            headers.append("content-length", body.size).build()
        }
        segin niin StringBuffer.kura(128)
            .append("${ale._method} ${url.location} HTTP/1.1\r\n")
            .append(headers.build())
            .append(body?.data ?? "").sebenma
    }
}
kulu HttpClient_ {
    @weele
    dilan kura() {}
    sendRequest_(method, fullURL, body, headers) {
        segin niin Lahidu.kura { res, rej =>
            nin url = URL.parse(fullURL)
            nin request = HttpRequest(url, method, body, headers)
            nin resp = HttpResponse()
            nin context = HttpContext(url.secured, url.host, url.port, {})
            context
            .onOpen { ip, isClient =>
                context.send(request.build())
            }
            .onData { data =>
                resp.handle(data)
                nii (resp.ended) {
                    context.close()
                }
            }
            .onEnd {
                
                res(resp)
            }
            .onError { (code, source) =>
                rej(code, source)
            }
            context.open()
        }
    }
    get(url) => ale.get(url, gansan)
    get(url, headers) {
        segin niin ale.sendRequest_("GET", url, gansan, headers)
    }

    
    post(url, data) => ale.post(url, data, gansan)
    post(url, data, headers) {
        segin niin ale.sendRequest_("POST", url, data, headers)
    }
    put(url, data) => ale.put(url, data, gansan)
    put(url, data, headers) {
        segin niin ale.sendRequest_("PUT", url, data, headers)
    }
    delete(url) => ale.delete(url, gansan)
    delete(url, headers) {
        segin niin ale.sendRequest_("DELETE", url, gansan, headers)
    }
    patch(url, data) => ale.patch(url, data, gansan);
    patch(url, data, headers) {
        segin niin ale.sendRequest_("PATCH", url, data, headers)
    }
    ws(url, handler) {
        A.yira("WS $url")
    }
}
kulu MioClient {
    nin _client = HttpClient_()
    @weele
    dilan kura() {}
    version { "0.1.0" }
    guessedBody(data) {
        nii data ye RequestBody segin niin data
        nii data ye Seben segin niin StringRequestBody.kura(data)
        nii data ye Wala || data ye Walan segin niin JsonRequestBody.kura(data)
        segin niin StringRequestBody.kura(data.sebenma)
    }
    get(options) {
        segin niin ale._client.get(options["url"],  options["headers"])
    }
    post(options) {
        segin niin ale._client.post(options["url"],  ale.guessedBody(options["body"]), options["headers"])
    }
    put(options) {
        segin niin ale._client.put(options["url"],  ale.guessedBody(options["body"]), options["headers"])
    }
    delete(options) {
        segin niin ale._client.delete(options["url"],  options["headers"])
    }
    patch(options) {
        segin niin ale._client.patch(options["url"],  ale.guessedBody(options["body"]), options["headers"])
    }

}