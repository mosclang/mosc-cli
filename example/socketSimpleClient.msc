kabo "net" nani Socket, SocketContext
kabo "timer" nani WaatiMassa

nin context = SocketContext.kura(0, {
    open: Tii.kura { socket, ip, isClient =>
        A.yira("Connected to server $ip $isClient")

        
        socket.write("Hello")
        WaatiMassa.sunogo(2000)
        socket.flush()
    },

    error: Tii.kura { socket, code, source =>
        A.yira("Socket error from $source: $code")
    },
    data: Tii.kura {socket, data =>
        A.yira("Data with ${data}")
        socket.close()
        # nii (!socket.data) {
        #   socket.data = {resp: ""}
        # }
        # socket.data["resp"] = "${socket.data["resp"]}$data"
        # A.yira("Data with ${data}")
        # nii (data.beBanNiin("\r\n")) {
        #  socket.close()
        # }
    },
    end: Tii.kura {socket =>
        A.yira("End ${socket.data}")
        socket.close()
    },
    close: Tii.kura { socket =>
        A.yira("Closed ${socket.data}")
        socket.close()
    },
    backPressing: tien,
    idleTime: 15
})
context.connect("127.0.0.1", 5000)